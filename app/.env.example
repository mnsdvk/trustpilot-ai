# Copy this file to .env.local and fill it in. Never commit .env.local.

# --- Public (visible in the browser) ---
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_CHAIN_ID=10143
# Fill these in after deploying the contracts in Remix
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_TOKEN_ADDRESS=
# Block number the vault was deployed at (shown in the deploy transaction). Receipts are read from here.
NEXT_PUBLIC_DEPLOY_BLOCK=
# Optional: explorer transaction URL prefix, for example https://<explorer>/tx/
NEXT_PUBLIC_EXPLORER_TX_URL=

# --- Server only (never exposed to the browser) ---
# Private key of the AGENT wallet. TESTNET ONLY. Generate with: npm run agent-key
AGENT_PRIVATE_KEY=

# LLM used to turn a plain-language request into a structured payment.
# Any OpenAI-compatible endpoint works. Check your provider's docs for the exact values.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# eth_getLogs block-range chunk size. Lower it if the RPC rejects the range.
LOG_CHUNK=90
